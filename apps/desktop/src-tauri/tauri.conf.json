{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duby",
  "version": "0.1.0",
  "identifier": "io.github.sidmuzammil.duby",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Duby",
        "width": 1120,
        "height": 780,
        "minWidth": 740,
        "minHeight": 560,
        "backgroundColor": "#f5f4ef"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Your thoughtful desktop companion",
    "longDescription": "An original 3D Linux companion with scoped local file tools and an optional managed OpenClaw runtime.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.41)",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64",
          "libsecret-tools"
        ]
      },
      "rpm": {
        "depends": ["libc.so.6(GLIBC_2.41)(64bit)"],
        "compression": {
          "type": "none"
        }
      }
    },
    "publisher": "Duby contributors",
    "copyright": "Copyright 2026 Duby contributors",
    "homepage": "https://github.com/sidmuzammil/DUBY"
  }
}
