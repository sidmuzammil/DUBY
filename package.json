{
  "name": "duby",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/desktop/vite.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:runtime": "node tests/runtime-smoke.mjs",
    "assets": "blender -b -t 4 --python scripts/create-duby.py",
    "assets:check": "node scripts/validate-assets.mjs",
    "desktop": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "package": "bash scripts/package-linux.sh",
    "check": "npm run build && npm test && npm run assets:check",
    "test:flow": "cargo build -p duby-broker --example socket_harness && node tests/runtime-file-flow.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@openclaw/gateway-client": "2026.8.1",
    "@openclaw/gateway-protocol": "2026.8.1",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "lucide-react": "1.49.0",
    "openclaw": "2026.9.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.5",
    "npm": "file:vendor/npm-11.20.0-duby.1.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "gltf-validator": "2.0.0-dev.3.10",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "npm": "$npm"
  }
}
